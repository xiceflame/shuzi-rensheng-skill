{
  "_说明": "Obsidian 核心插件开关。删掉本注释行后可直接用作 .obsidian/core-plugins.json。",
  "_关键": "graph(图谱) / backlink(反向链接) / outgoing-link(出链) / properties(属性) / templates(模板) / daily-notes(日记) 是核心，必须开",
  "file-explorer": true,
  "global-search": true,
  "switcher": true,
  "graph": true,
  "backlink": true,
  "canvas": true,
  "outgoing-link": true,
  "tag-pane": true,
  "properties": true,
  "page-preview": true,
  "daily-notes": true,
  "templates": true,
  "note-composer": true,
  "command-palette": true,
  "editor-status": true,
  "bookmarks": true,
  "outline": true,
  "word-count": true,
  "file-recovery": true,
  "bases": true,
  "footnotes": false,
  "slash-command": false,
  "markdown-importer": false,
  "zk-prefixer": false,
  "random-note": false,
  "slides": false,
  "audio-recorder": false,
  "workspaces": false,
  "publish": false,
  "sync": true,
  "webviewer": false
}
