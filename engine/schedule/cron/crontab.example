# 数字人生 · 系统原生 cron 模板（Linux / 任何有 cron 的系统）
# 用法：crontab -e 贴入；把 __ENGINE__ 换成 engine 目录的绝对路径。
# 注：需要 LLM 的只有 4 个任务；其余是纯脚本，不烧 token。

# ── 纯脚本任务（零 token）──
*/5 * * * *   python3 $HOME/.config/qkb/qkb-follow.py --once   # ★近实时:增量入库(否则新页要等4h)
23 */4 * * *  bash __ENGINE__/scripts-extra.sh transcribe   # 语音转写
55 */4 * * *  bash __ENGINE__/scripts-extra.sh rebuild      # 重建证据层+向量索引

# ── 需要 LLM 的任务（走适配器，自动选引擎）──
7 8,21 * * *  bash __ENGINE__/run.sh chat-ingest            # 写「我的每一天」
40 */4 * * *  bash __ENGINE__/run.sh finance-ingest         # 财务增量
7 9 1 * *     bash __ENGINE__/run.sh rollup                 # 月/季汇总
7 21 * * 0    bash __ENGINE__/run.sh lint                   # 知识库体检
7 10 * * 1    bash __ENGINE__/run.sh idea-review            # 想法复盘
